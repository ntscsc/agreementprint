rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin access strictly via verified administrator email
    function isAdmin() {
      return isSignedIn()
        && (
          request.auth.token.email == "pradeep1992official@gmail.com"
          || request.auth.token.email == "ntcsc@gmail.com"
        )
        && request.auth.token.email_verified == true;
    }

    function isOwner() {
      return isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Clients can bypass the form. Reject incomplete records before they can
    // break customer/admin screens or enter the payment workflow.
    function validPerson(data) {
      return data is map
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100
        && (!('relativeName' in data) || (data.relativeName is string && data.relativeName.size() <= 100 && (data.relativeName.size() == 0 || data.relativeName.size() >= 2)))
        && (!('relationship' in data) || data.relationship == '' || data.relationship in ['Son of', 'Daughter of', 'Wife of', 'Husband of', 'Child of', 'Spouse of'])
        && (data.age is int || data.age is string)
        && data.address is string && data.address.size() >= 10 && data.address.size() <= 2000
        && data.phone is string && data.phone.matches('^[6-9][0-9]{9}$');
    }

    function validProperty(data) {
      return data is map
        && data.fullAddress is string && data.fullAddress.size() >= 12 && data.fullAddress.size() <= 2000
        && data.city is string && data.city.size() >= 2 && data.city.size() <= 100
        && data.pincode is string && data.pincode.matches('^6[0-4][0-9]{4}$')
        && data.propertyType in ['House', 'Flat', 'Commercial Shop']
        && data.furnishing in ['Unfurnished', 'Semi-Furnished', 'Fully Furnished'];
    }

    function validAgreement(data) {
      return validPerson(data.ownerDetails) && validPerson(data.tenantDetails)
        && validProperty(data.propertyDetails)
        && data.agreementTerms is map
        && (!('language' in data.agreementTerms) || data.agreementTerms.language in ['English', 'Tamil'])
        && (!('paintingDeduction' in data.agreementTerms) || (data.agreementTerms.paintingDeduction is number && data.agreementTerms.paintingDeduction >= 0 && data.agreementTerms.paintingDeduction <= 1000000000))
        && (!('language' in data.agreementTerms) || data.agreementTerms.language != 'Tamil' || data.propertyDetails.propertyType == 'Commercial Shop' || 'paintingDeduction' in data.agreementTerms)
        && (!('agreementType' in data.agreementTerms) || data.agreementTerms.agreementType in ['Rental', 'Lease'])
        && (('agreementType' in data.agreementTerms && data.agreementTerms.agreementType == 'Lease')
          ? (data.agreementTerms.language == 'English'
            && data.propertyDetails.propertyType in ['House', 'Flat']
            && data.agreementTerms.monthlyRent == 0
            && data.agreementTerms.rentIncreasePct == 0
            && data.agreementTerms.securityDeposit > 0)
          : data.agreementTerms.monthlyRent > 0)
        && data.agreementTerms.monthlyRent is number && data.agreementTerms.monthlyRent <= 1000000000
        && data.agreementTerms.securityDeposit is number && data.agreementTerms.securityDeposit >= 0 && data.agreementTerms.securityDeposit <= 1000000000
        && data.agreementTerms.maintenanceCharges is number && data.agreementTerms.maintenanceCharges >= 0 && data.agreementTerms.maintenanceCharges <= 1000000000
        && data.agreementTerms.tenureMonths is int && data.agreementTerms.tenureMonths >= 1 && data.agreementTerms.tenureMonths <= 120
        && data.agreementTerms.startDate is string && data.agreementTerms.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.agreementTerms.stampPaperDenomination in [100, 200]
        && data.agreementTerms.deliveryRecipient in ['Owner', 'Tenant']
        && data.agreementTerms.deliveryLocation in ['Within Chennai', 'Within Tamil Nadu']
        && (!('extraCopies' in data.agreementTerms) || (data.agreementTerms.extraCopies is int && data.agreementTerms.extraCopies >= 0 && data.agreementTerms.extraCopies <= 100))
        && data.agreementTerms.includeNotary is bool
        && data.proofUploads is map;
    }

    // Owner correction logic:
    // Can only be updated if existing status is 'Documents needed'
    // Can only transition status to 'Under verification'
    // Customer correction submissions are validated and audited by the server API.

    // Default deny for all unmatched documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Contact enquiries
    // Custom requests (including internal notes) are served by authorized API routes only.
    match /customAgreementRequests/{requestId} {
      allow read, write: if false;
    }
    match /customAgreementLimits/{limitId} {
      allow read, write: if false;
    }
    match /customAgreementAudit/{logId} {
      allow read, write: if false;
    }

    match /enquiries/{enquiryId} {
      // Enquiries are created only by the rate-limited server Admin SDK route.
      allow create: if false;

      // Read, update, and delete reserved exclusively for vendor admin
      allow read, update, delete: if isAdmin();
    }

    match /orderTrackingLimits/{limitId} {
      allow read, write: if false;
    }

    // First-order discount reservations and redemptions are server-managed.
    match /firstOrderCoupons/{uid} {
      allow read, write: if false;
    }

    // In-progress customer draft forms: owner-only access
    match /drafts/{uid} {
      allow read, delete: if isSignedIn() && request.auth.uid == uid;
      allow write: if isSignedIn() 
        && request.auth.uid == uid
        && request.resource.data.ownerUid == uid
        && request.resource.data.keys().hasOnly([
          'ownerUid',
          'currentStep',
          'formData',
          'updatedAt'
        ]);
    }

    // Orders Collection
    match /orders/{orderId} {
      // Create conditions:
      // 1. Authenticated user matching ownerUid
      // 2. Initial status must be 'Submitted'
      // 3. Customers may supply only Pending; all gateway metadata is server-managed.
      // 4. Disallow courier and correctionMessage on initial creation
      // 5. Restrict allowed payload keys using hasOnly()
      allow create: if isSignedIn()
        && validAgreement(request.resource.data)
        && request.resource.data.customerEmail is string
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.orderId == orderId
        && request.resource.data.status == 'Submitted'
        && request.resource.data.payment is map
        && request.resource.data.payment.keys().hasOnly(['status'])
        && request.resource.data.payment.status == 'Pending'
        && !('courier' in request.resource.data)
        && !('correctionMessage' in request.resource.data)
        && request.resource.data.keys().hasOnly([
          'orderId',
          'ownerUid',
          'referralCode',
          'customerEmail',
          'customerPhone',
          'ownerDetails',
          'tenantDetails',
          'propertyDetails',
          'agreementTerms',
          'proofUploads',
          'status',
          'payment',
          'notes',
          'createdAt',
          'updatedAt'
        ]);

      // Read access: owner or admin only
      allow read: if isAdmin() || isOwner();

      // Update access:
      // - Admins manage workflow; payment records are gateway/server-managed.
      // - Customer corrections use the transactional server API; direct client edits are denied.
      allow update: if (isAdmin()
        && !('cancellationRefundId' in resource.data)
        && !(resource.data.payment.status == 'Paid' && request.resource.data.status == 'Cancelled')
        && (!('replacementPendingId' in resource.data) || resource.data.replacementPendingId == null)
        && !('replacedByOrderId' in resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['payment', 'replacementPendingId', 'replacesOrderId', 'replacedByOrderId', 'replacementRequestId', 'replacementAdjustment', 'modificationReviewId', 'modificationReviewOutcome', 'cancellationRefundId', 'cancellationRefundAmount', 'cancellationRefundStatus', 'cancellationRefundNote', 'cancellationRewardCreditsReturned', 'correctionRequestId', 'correctionStatus', 'correctionSubmittedAt', 'correctionChangedFields', 'correctionMessage'])
        && (!('preparationStartedAt' in resource.data)
          || (request.resource.data.preparationStartedAt == resource.data.preparationStartedAt))
        && (!(request.resource.data.status in ['Drafting', 'Dispatched', 'Delivered'])
          && !(resource.data.status in ['Drafting', 'Dispatched', 'Delivered'])
          || (request.resource.data.preparationStartedAt is string
            && request.resource.data.preparationStartedAt.size() > 0))
        && (!(resource.data.payment.status == 'Paid')
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerDetails', 'tenantDetails', 'propertyDetails', 'agreementTerms']))
        && (
          resource.data.payment.status == 'Paid'
          || (!(request.resource.data.status in ['Drafting', 'Dispatched', 'Delivered'])
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['courier']))
        ));

      // Deletions: completely forbidden
      allow delete: if false;
    }

    // Gateway associations are created and read only by the server Admin SDK.
    match /razorpayCheckouts/{attemptId} { allow read, write: if false; }
    match /razorpayOrderReferences/{attemptId} { allow read, write: if false; }
    match /razorpayRefunds/{refundId} { allow read, write: if false; }
    match /razorpayTestPayments/{attemptId} { allow read, write: if false; }
    match /razorpayTestCustomers/{customerId} { allow read, write: if false; }

    match /phonepePaymentAttempts/{attemptId} {
      allow read, write: if false;
    }

    match /orderEditHistory/{editId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Refund eligibility, reservations and gateway references are server-managed.
    match /creditRefundRequests/{requestId} {
      allow read, write: if false;
    }

    // Agent assignments and manual rewards are accessible only through authenticated server APIs.
    match /agentReferralCustomers/{customerId} {
      allow read, write: if false;
    }

    // Visitor counts and deduplication are accessed only through server APIs.
    match /visitorAnalytics/{id} { allow read, write: if false; }
    match /visitorRegistry/{id} { allow read, write: if false; }
    match /visitorAnalyticsLimits/{id} { allow read, write: if false; }

    // Administrative activity audit logs: admin only
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // System & Pricing Settings (accessible to all for checkout, updatable by admin only)
    function isValidPrice(amount, minimum) {
      return amount is int && amount >= minimum && amount <= 100000;
    }

    function isValidPricing(data) {
      return isValidPrice(data.stamp100Chennai, 150)
        && isValidPrice(data.stamp100TamilNadu, 200)
        && isValidPrice(data.stamp200Chennai, 250)
        && isValidPrice(data.stamp200TamilNadu, 300)
        && isValidPrice(data.notaryExtraFee, 0);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin()
        && settingId != 'paymentGateway'
        && (settingId != 'pricing' || isValidPricing(request.resource.data))
        && (settingId != 'referrals' || (request.resource.data.rewardAmount is int
          && request.resource.data.rewardAmount >= 0 && request.resource.data.rewardAmount <= 100000
          && request.resource.data.refereeDiscountAmount is int
          && request.resource.data.refereeDiscountAmount >= 0 && request.resource.data.refereeDiscountAmount <= 100000))
        && (settingId != 'coupons' || (request.resource.data.customerDiscountAmount is int
          && request.resource.data.customerDiscountAmount >= 0
          && request.resource.data.customerDiscountAmount <= 100000));
    }
  }
}
